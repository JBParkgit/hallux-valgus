[Unit]
Description=Hallux valgus measurement API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=hv
Group=hv
WorkingDirectory=/opt/hv-server
ExecStart=/opt/hv-server/.venv/bin/uvicorn hv_server.main:app --host 127.0.0.1 --port 8100 --workers 1 --proxy-headers
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hv-server

[Install]
WantedBy=multi-user.target
